# Brevo (Sendinblue) Transactional Email API for Password Reset OTPs
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support@covriq.ai"
BREVO_SENDER_NAME="CovrIQ Security"

# SerpApi Sports & Search Intelligence (Primary Provider - Server-side only)
SERPAPI_API_KEY=""

# Client URL for CORS
CLIENT_URL="http://localhost:5174"

