# CovrIQ Server Environment Configuration
PORT=5003
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/covriq?schema=public"

# Authentication & Security
JWT_SECRET="covriq_super_secure_jwt_secret_key_2026_sports_ai"
JWT_EXPIRES_IN="7d"

# OpenAI API Key (Kept strictly server-side)
# Uses gpt-5.6 with web search enabled
OPENAI_API_KEY=""
